---
const entry = Astro.locals.starlightRoute.entry;
const title = entry.data.title;
const description = entry.data.description;
const sectionNames: Record<string, string> = {
  "getting-started": "Get Started",
  fundamentals: "Fundamentals",
  features: "Features",
  integrations: "Integrations",
  tutorials: "Tutorials",
  resources: "Resources",
  experimental: "Experimental",
  proposals: "Proposals",
};
const section = sectionNames[entry.id.split("/")[0] ?? ""];
const descriptionParts = description?.split("**") ?? [];
---

<div class="art-page-heading">
  {section && <p class="art-eyebrow">{section}</p>}
  <h1 id="_top">{title}</h1>
  {description && (
    <p class="art-description">
      {descriptionParts.map((part, index) => index % 2 === 1 ? <strong>{part}</strong> : part)}
    </p>
  )}
</div>
