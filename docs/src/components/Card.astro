---
interface Props {
  title: string;
  icon?: string;
  href?: string;
  horizontal?: boolean;
  arrow?: boolean;
}

const { title, icon, href, horizontal = false, arrow = false } = Astro.props;
const Tag = href ? "a" : "div";
const iconUrl = icon
  ? `url("https://d3gk2c5xim1je2.cloudfront.net/fontawesome/v7.2.0/regular/${icon}.svg")`
  : undefined;
---

<Tag
  class:list={[
    "art-card",
    { "art-card-link": href, "art-card-horizontal": horizontal },
  ]}
  href={href}
>
  {iconUrl && (
    <span class="art-icon art-card-icon" style={`--art-icon: ${iconUrl}`}></span>
  )}
  <span class="art-card-text">
    <span class="art-card-title">{title}</span>
    <span class="art-card-body"><slot /></span>
  </span>
  {(arrow || href) && (
    <svg class="art-card-arrow" aria-hidden="true" viewBox="0 0 18 18">
      <path d="M14.25 3.75 3.76 14.24M4.71 3.75h9.54v9.54" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )}
</Tag>
