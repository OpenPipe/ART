---
import Search from "@astrojs/starlight/components/Search.astro";
import ThemeSelect from "@astrojs/starlight/components/ThemeSelect.astro";
---

<div class="art-header">
  <a class="art-header-title" href="/" aria-label="ART home page">
    <img class="art-logo-light" src="/images/site-assets/logo/light.svg" alt="OpenPipe" />
    <img class="art-logo-dark" src="/images/site-assets/logo/dark.svg" alt="OpenPipe" />
  </a>
  <div class="art-header-search print:hidden"><Search /></div>
  <nav class="art-header-links sl-hidden lg:sl-flex print:hidden" aria-label="Project links">
    <a href="https://discord.gg/zbBHRUpwf4">Discord</a>
    <a href="https://openpipe.ai/blog">Blog</a>
    <a class="art-github-button" href="https://github.com/openpipe/ART">GitHub <span aria-hidden="true">›</span></a>
  </nav>
  <div class="art-theme print:hidden"><ThemeSelect /></div>
</div>
