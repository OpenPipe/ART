---
import MobileMenuToggle from "@astrojs/starlight/components/MobileMenuToggle.astro";

const { hasSidebar } = Astro.locals.starlightRoute;
---

<div class="page sl-flex">
  <header class="header">
    <div class="art-header-shell"><slot name="header" /></div>
  </header>

  <div class:list={["art-page-shell", { "art-page-shell-has-sidebar": hasSidebar }]}>
    {
      hasSidebar && (
        <nav
          class="sidebar print:hidden"
          aria-label={Astro.locals.t("sidebarNav.accessibleLabel")}
        >
          <MobileMenuToggle />
          <div id="starlight__sidebar" class="sidebar-pane">
            <div class="sidebar-content sl-flex">
              <slot name="sidebar" />
            </div>
          </div>
        </nav>
      )
    }

    <div class="main-frame"><slot /></div>
  </div>
</div>

<style>
  @layer starlight.core {
    .page {
      min-height: 100vh;
      flex-direction: column;
    }

    .header {
      position: fixed;
      z-index: var(--sl-z-index-navbar);
      inset-block-start: 0;
      inset-inline-start: 0;
      width: 100%;
      height: var(--sl-nav-height);
    }

    .art-header-shell {
      width: 100%;
      max-width: var(--art-shell-width);
      height: 100%;
      margin-inline: auto;
      padding-inline: 1rem;
    }

    .art-page-shell,
    .main-frame {
      min-width: 0;
    }

    .main-frame {
      padding-top: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height));
    }

    .sidebar-pane {
      visibility: var(--sl-sidebar-visibility, hidden);
      position: fixed;
      z-index: var(--sl-z-index-menu);
      inset-block: var(--sl-nav-height) 0;
      inset-inline-start: 0;
      width: 100%;
      overflow-y: auto;
      scrollbar-gutter: stable;
      background-color: var(--sl-color-black);
    }

    :global([aria-expanded="true"]) ~ .sidebar-pane {
      --sl-sidebar-visibility: visible;
    }

    .sidebar-content {
      min-height: max-content;
      height: 100%;
      padding: 1rem var(--sl-sidebar-pad-x) 0;
      flex-direction: column;
      gap: 1rem;
    }

    @media (min-width: 50rem) {
      .art-header-shell {
        padding-inline: 3rem;
      }

      .art-page-shell-has-sidebar {
        display: grid;
        grid-template-columns: var(--sl-sidebar-width) minmax(0, 1fr);
        width: 100%;
        max-width: var(--art-shell-width);
        margin-inline: auto;
        padding-inline: var(--art-shell-pad-x);
      }

      .sidebar {
        min-width: 0;
      }

      .sidebar-pane {
        --sl-sidebar-visibility: visible;

        position: sticky;
        inset-block-start: var(--sl-nav-height);
        width: 100%;
        height: calc(100vh - var(--sl-nav-height));
        background-color: var(--sl-color-bg-sidebar);
      }

      .sidebar-content::after {
        content: "";
        padding-bottom: 1px;
      }

      .main-frame {
        grid-column: 2;
        padding-top: var(--sl-nav-height);
      }
    }
  }
</style>
