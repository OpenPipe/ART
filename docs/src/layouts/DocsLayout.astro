---
import "@fontsource-variable/inter";
import "../styles/custom.css";
import type { MarkdownHeading } from "astro";
import Header from "../components/Header.astro";
import Pagination from "../components/Pagination.astro";
import Sidebar from "../components/Sidebar.astro";
import TableOfContents from "../components/TableOfContents.astro";
import { neighborsFor, pageFor } from "../navigation";

interface Props {
  slug: string;
  title: string;
  description?: string;
  headings: MarkdownHeading[];
  sourcePath: string;
}

const { slug, title, description, headings, sourcePath } = Astro.props;
const page = pageFor(slug);
const section = page?.section ?? slug.split("/")[0]?.replaceAll("-", " ").replace(/\b\w/g, (letter) => letter.toUpperCase());
const { previous, next } = neighborsFor(slug);
const canonical = new URL(Astro.url.pathname, Astro.site);
const descriptionParts = description?.split("**") ?? [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description ?? "Train LLMs to be better agents using reinforcement learning."} />
    <link rel="icon" type="image/png" href="/images/site-assets/favicon.png" />
    <link rel="canonical" href={canonical} />
    <title>{title} - ART</title>
    <script is:inline>
      const savedTheme = localStorage.getItem("art-theme");
      const theme = savedTheme === "light" || savedTheme === "dark"
        ? savedTheme
        : matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      document.documentElement.dataset.theme = theme;
    </script>
    <script is:inline src="/analytics.js" async></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header"><Header /></header>
    <div class="site-shell">
      <aside id="docs-sidebar" class="docs-sidebar print-hidden">
        <nav aria-label="Documentation"><Sidebar currentSlug={slug} /></nav>
      </aside>
      <main id="main-content" class="docs-main" data-pagefind-body>
        <div class="page-columns">
          <TableOfContents headings={headings} />
          <div class="article-pane">
            <article class="article">
              <header class="page-heading">
                {section && <p class="page-eyebrow">{section}</p>}
                <h1>{title}</h1>
                {description && (
                  <p class="page-description">
                    {descriptionParts.map((part, index) => index % 2 === 1 ? <strong>{part}</strong> : part)}
                  </p>
                )}
              </header>
              <div class="doc-content"><slot /></div>
              <footer class="page-footer">
                <a class="edit-link" href={`https://github.com/OpenPipe/ART/edit/main/docs/src/content/docs/${sourcePath}`}>
                  <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m13.9 2.6 3.5 3.5M3 17l1-4 9.9-9.9a1.4 1.4 0 0 1 2 0l1 1a1.4 1.4 0 0 1 0 2L7 16l-4 1Z" /></svg>
                  Edit page
                </a>
                <Pagination previous={previous} next={next} />
              </footer>
            </article>
          </div>
        </div>
      </main>
    </div>
  </body>
</html>
